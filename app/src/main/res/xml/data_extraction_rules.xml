<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Pairing ciphertext cannot be restored without its Android Keystore key. -->
        <exclude domain="sharedpref" path="bo_sideload_encrypted_pair_records.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Require the user to pair again after moving to another device. -->
        <exclude domain="sharedpref" path="bo_sideload_encrypted_pair_records.xml" />
    </device-transfer>
</data-extraction-rules>
